# Non-secret LeoLM configuration. Put real credentials in the process environment only.
LEOLM_CONVERSATION_API_KEY=
LEOLM_PORCUPINE_ACCESS_KEY=
LEOLM_MODEL=google/gemini-2.0-flash-thinking-exp:free
LEOLM_CONVERSATION_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LEOLM_LANGUAGE=it-IT
LEOLM_WAKE_WORD=Panda
LEOLM_WAKE_WORD_PATH=Panda_it_raspberry-pi_v3_0_0.ppn
LEOLM_WAKE_MODEL_PATH=porcupine_params_it.pv
LEOLM_INPUT_DEVICE=
LEOLM_OUTPUT_DEVICE=
LEOLM_NETWORK_TIMEOUT_SECONDS=30
LEOLM_RETRY_COUNT=2
LEOLM_RETRY_BACKOFF_SECONDS=1
LEOLM_CONTEXT_IDLE_TIMEOUT_SECONDS=600

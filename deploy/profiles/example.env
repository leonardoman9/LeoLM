# Safe deployment template. Keep real profiles outside the repository.
DEVICE_ID=pi-soggiorno
DEVICE_HOSTNAME=leolm-soggiorno
WIFI_SSID=replace-on-device
WIFI_PASSWORD=replace-on-device
WIFI_COUNTRY=IT
WIFI_HIDDEN=false
TARGET_USER=leolm
TARGET_ARCH=armhf
LEOLM_CONVERSATION_API_KEY=replace-on-device
LEOLM_MODEL=google/gemini-2.0-flash-thinking-exp:free
LEOLM_CONVERSATION_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LEOLM_LANGUAGE=it-IT
LEOLM_WAKE_WORD=Panda
LEOLM_VOSK_MODEL_PATH=models/vosk-model-small-it-0.22
LEOLM_WAKE_SAMPLE_RATE=16000
LEOLM_INPUT_DEVICE=
LEOLM_OUTPUT_DEVICE=
LEOLM_NETWORK_TIMEOUT_SECONDS=30
LEOLM_RETRY_COUNT=2
LEOLM_RETRY_BACKOFF_SECONDS=1
LEOLM_CONTEXT_IDLE_TIMEOUT_SECONDS=600
